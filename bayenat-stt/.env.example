# Bayenat / بيّنات — example environment configuration.
# Copy to ".env" and adjust as needed.

# --- General ---
APP_NAME=Bayenat STT
DEFAULT_LANGUAGE=ar

# --- Upload constraints ---
MAX_FILE_SIZE_MB=200
# Comma-separated list of allowed audio extensions.
ALLOWED_EXTENSIONS=mp3,wav,m4a

# --- Engine configuration ---
# Use a smaller model (e.g. "small" or "base") for local testing to avoid
# downloading the multi-GB large-v3 weights.
FASTER_WHISPER_MODEL=large-v3
WHISPER_MODEL=large-v3
# "auto" picks CUDA when available, otherwise CPU.
DEVICE=auto

# Enable once a real third backend (Parakeet / HuggingFace / external API) is wired up.
THIRD_ENGINE_ENABLED=false
